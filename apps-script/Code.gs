/* ====== أدوات مساعدة ====== */
function json_(out) {
  return ContentService.createTextOutput(JSON.stringify(out))
    .setMimeType(ContentService.MimeType.JSON);
}

function ss_() {
  try {
    const active = SpreadsheetApp.getActiveSpreadsheet();
    if (active) return active;
  } catch (e) {}
  return SpreadsheetApp.openById(SHEET_ID);
}

function isAdmin_() {
  try {
    const email = (Session.getActiveUser() && Session.getActiveUser().getEmail()) || "";
    return ALLOWED_EMAILS.indexOf(email.toLowerCase()) !== -1;
  } catch (e) { return false; }
}

/* تخزين المحتوى كاملًا كنص JSON مقسّم على صفوف (لتجاوز حد الخلية) */
function readStore_() {
  const sh = ss_().getSheetByName(STORE_TAB);
  if (!sh) return null;
  const last = sh.getLastRow();
  if (!last) return null;
  const vals = sh.getRange(1, 1, last, 1).getValues();
  const text = vals.map(r => r[0]).join("");
  if (!text) return null;
  try { return JSON.parse(text); } catch (e) { return null; }
}

function writeStore_(text) {
  const ss = ss_();
  let sh = ss.getSheetByName(STORE_TAB);
  if (!sh) sh = ss.insertSheet(STORE_TAB);
  const rows = [];
  for (let i = 0; i < text.length; i += CHUNK) rows.push([text.slice(i, i + CHUNK)]);
  const old = sh.getLastRow();
  if (old > rows.length) sh.getRange(rows.length + 1, 1, old - rows.length, 1).clearContent();
  sh.getRange(1, 1, rows.length, 1).setValues(rows);
}

function getContent_() {
  const stored = readStore_();
  if (stored && stored.stories) return stored;
  return JSON.parse(DEFAULT_CONTENT_JSON);
}

function sheetRows_(ss, name) {
  const sh = ss.getSheetByName(name);
  if (!sh) return [];
  const values = sh.getDataRange().getValues();
  if (values.length < 2) return [];
  const headers = values[0];
  return values.slice(1)
    .filter(r => r.some(c => c !== "" && c != null))
    .map(r => {
      const o = {};
      headers.forEach((h, i) => { o[h] = r[i]; });
      return o;
    });
}

function writeRows_(ss, name, headers, rows) {
  let sh = ss.getSheetByName(name);
  if (!sh) sh = ss.insertSheet(name);
  sh.clearContents();
  sh.getRange(1, 1, 1, headers.length).setValues([headers]);
  if (rows.length) {
    sh.getRange(2, 1, rows.length, headers.length).setValues(
      rows.map(o => headers.map(h => (o[h] == null ? "" : String(o[h]).slice(0, 49000))))
    );
  }
}

/* نسخة مقروءة للإنسان داخل الجدول (للاطلاع فقط؛ المصدر هو content_store) */
function mirrorTabs_(d) {
  const ss = ss_();
  const now = new Date().toISOString();
  if (d.stories) writeRows_(ss, "stories",
    ["id", "title", "description", "text", "cover", "audio", "updated_at"],
    d.stories.map(s => ({ id: s.id, title: s.title, description: s.desc, text: s.text, cover: s.cover, audio: s.audio, updated_at: now })));
  if (d.activities) writeRows_(ss, "activities",
    ["id", "story_id", "title", "description", "place", "date", "images", "updated_at"],
    d.activities.map(a => ({ id: a.id, story_id: a.storyId, title: a.title, description: a.desc, place: a.place || "", date: a.date || "", images: (a.images || []).join("|"), updated_at: now })));
  if (d.press) writeRows_(ss, "press",
    ["id", "category", "outlet", "title", "date", "url", "text", "image", "photos"],
    d.press.map(p => ({ id: p.id, category: p.category, outlet: p.outlet || "", title: p.title || p.headline || "", date: p.date || "", url: p.url || "", text: p.text || p.description || "", image: p.image || p.cover || "", photos: (p.photos || []).join("|") })));
  if (d.partners) writeRows_(ss, "partners",
    ["id", "name", "logo", "facebook", "post_url", "note", "updated_at"],
    d.partners.map(p => ({ id: p.id, name: p.name, logo: p.logo, facebook: p.facebook, post_url: p.postUrl || "", note: p.note || "", updated_at: now })));
  if (d.team) writeRows_(ss, "team",
    ["id", "name", "role", "photo", "facebook", "phone", "placeholder", "updated_at"],
    d.team.map(m => ({ id: m.id, name: m.name, role: m.role, photo: m.photo || "", facebook: m.facebook || "", phone: m.phone || "", placeholder: m.placeholder ? "نعم" : "", updated_at: now })));
}

function saveContent_(data) {
  if (!data || !data.stories) throw new Error("بيانات غير صالحة");
  writeStore_(JSON.stringify(data));
  try { mirrorTabs_(data); } catch (e) { /* النسخ المقروء ثانوي */ }
  return true;
}

function uploadMedia_(filename, mimeType, base64) {
  const folder = DriveApp.getFolderById(MEDIA_FOLDER_ID);
  const blob = Utilities.newBlob(Utilities.base64Decode(base64), mimeType || "application/octet-stream", filename);
  const file = folder.createFile(blob);
  file.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW);
  return { id: file.getId(), url: "https://drive.google.com/uc?export=view&id=" + file.getId() };
}

/* ====== واجهة الويب العامة ====== */
function doGet(e) {
  const action = (e && e.parameter && e.parameter.action) || "";
  if (action === "data") return json_(getContent_());
  if (action === "ping") return json_({ ok: true, service: "hikaya-min-qarya", version: "1.3" });

  // أي طلب آخر: لوحة الإدارة (تُعرض للمالك المصرّح فقط)
  if (!isAdmin_()) {
    return HtmlService.createHtmlOutput(
      '<div dir="rtl" style="font-family:sans-serif;text-align:center;padding:60px 20px">' +
      "<h2>هذه الصفحة مخصصة لإدارة موقع «حكاية من قرية»</h2>" +
      "<p>إذا كنت صاحب المشروع، سجّل الدخول بحساب Google المعتمد ثم أعد فتح الرابط.</p></div>"
    ).setTitle("لوحة الإدارة");
  }
  return HtmlService.createHtmlOutputFromFile("Admin")
    .setTitle("لوحة إدارة حكاية من قرية")
    .addMetaTag("viewport", "width=device-width, initial-scale=1")
    .setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL);
}

/* مسار قديم للوحة admin.html الاحتياطية (المزامنة بالرمز) */
function doPost(e) {
  try {
    const body = JSON.parse(e.postData.contents || "{}");
    if (body.secret !== LEGACY_SECRET && !isAdmin_()) return json_({ ok: false, error: "غير مصرّح" });
    if (body.action === "uploadMedia" && body.filename && body.base64) {
      const out = uploadMedia_(String(body.filename), String(body.mimeType || ""), String(body.base64));
      return json_({ ok: true, url: out.url, id: out.id });
    }
    if (body.data) {
      saveContent_(body.data);
      return json_({ ok: true });
    }
    return json_({ ok: false, error: "لا يوجد إجراء" });
  } catch (err) {
    return json_({ ok: false, error: String(err) });
  }
}

/* ====== دوال لوحة الإدارة (تُستدعى من واجهة Admin عبر google.script.run) ====== */
function apiGetData() {
  if (!isAdmin_()) throw new Error("غير مصرّح");
  return getContent_();
}

function apiSaveContent(data) {
  if (!isAdmin_()) throw new Error("غير مصرّح");
  saveContent_(data);
  return { ok: true, at: new Date().toISOString() };
}

function apiUploadMedia(filename, mimeType, base64) {
  if (!isAdmin_()) throw new Error("غير مصرّح");
  if (!base64 || base64.length > 40 * 1024 * 1024) throw new Error("الملف كبير جدًا (الحد 30 ميجابايت تقريبًا)");
  const out = uploadMedia_(String(filename || "file"), String(mimeType || ""), String(base64));
  return { ok: true, url: out.url, id: out.id };
}

function apiListMedia() {
  if (!isAdmin_()) throw new Error("غير مصرّح");
  const folder = DriveApp.getFolderById(MEDIA_FOLDER_ID);
  const files = folder.getFiles();
  const out = [];
  while (files.hasNext()) {
    const f = files.next();
    out.push({ id: f.getId(), name: f.getName(), mime: f.getMimeType(), url: "https://drive.google.com/uc?export=view&id=" + f.getId(), updated: f.getLastUpdated().toISOString() });
  }
  out.sort((a, b) => (a.updated < b.updated ? 1 : -1));
  return out.slice(0, 200);
}
